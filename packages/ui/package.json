{
  "name": "@softglass/ui",
  "version": "1.0.0",
  "private": false,
  "description": "Softglass atomic React components — soft glass, theme via tokens.",
  "license": "MIT",
  "author": "Softglass contributors",
  "homepage": "https://github.com/ArdaDDemir/softglass#readme",
  "bugs": {
    "url": "https://github.com/ArdaDDemir/softglass/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArdaDDemir/softglass.git",
    "directory": "packages/ui"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node ./scripts/ensure-use-client.mjs",
    "dev": "tsup --watch --onSuccess \"node ./scripts/ensure-use-client.mjs\"",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@softglass/tokens": "^1.0.0",
    "@types/react": "*",
    "@types/react-dom": "*",
    "react": "^18.0.0 || ^19.0.0 || ^19.0.0-rc",
    "react-dom": "^18.0.0 || ^19.0.0 || ^19.0.0-rc"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tsup": "^8.5.1",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "react",
    "design-system",
    "glassmorphism",
    "softglass",
    "nextjs",
    "soft-ui",
    "components"
  ],
  "publishConfig": {
    "access": "public"
  }
}
